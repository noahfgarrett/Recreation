{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Default permissions for the Recreation desktop shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/recreation-extractor",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/llama-server",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
